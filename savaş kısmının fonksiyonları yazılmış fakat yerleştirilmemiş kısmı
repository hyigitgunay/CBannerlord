// Seviye Atlama Fonksiyonu
void seviyeAtla(Ozan *ozan) {
    ozan->seviye++;
    ozan->can += 20;
    ozan->moral += 10;
    ozan->hijyen += 10;
    ozan->altin += 5;
    ozan->tokluk += 5;

    // Beceri puanları veriliyor
    ozan->beceri_puani += 1;
    printf("Seviyeniz %d oldu!\n", ozan->seviye);
    printf("Beceri puanlariniz arttı: %d\n", ozan->beceri_puani);

    // Beceri seçenekleri
    for (int i = 0; i < MAX_BECERILER; i++) {
        printf("%d. Beceri: %d\n", i + 1, ozan->beceriler[i]);
    }

    printf("Hangi beceriyi geliştirmek istiyorsunuz (1-%d)? ", MAX_BECERILER);
    int beceriSecim;
    scanf("%d", &beceriSecim);
    if (beceriSecim >= 1 && beceriSecim <= MAX_BECERILER) {
        ozan->beceriler[beceriSecim - 1]++;
        printf("Beceri %d arttı!\n", beceriSecim);
    }
}

// Durumu Goster Fonksiyonu
void durumu_goster(Ozan ozan) {
    printf("\n--- Karakter Durumu ---\n");
    printf("Isim: %s\nCalgi: %s\n", ozan.ozanAdi, ozan.calgiAdi);
    printf("Can: %d\nYas: %d\nMoral: %d\nTokluk: %d\nUyku: %d\nHijyen: %d\n", ozan.can,ozan.yas,ozan.moral, ozan.tokluk, ozan.uyku, ozan.hijyen);
    printf("Seviye: %d\nTecrube Puani: %d\nAltin: %d\n", ozan.seviye, ozan.tecrube, ozan.altin);
    printf("Guc: %d\nCeviklik: %d\nDayaniklilik: %d\nKarizma: %d\nToplayicilik: %d\n", ozan.guc, ozan.ceviklik, ozan.dayaniklilik, ozan.karizma, ozan.toplayicilik);
    printf("----------\n");
}

