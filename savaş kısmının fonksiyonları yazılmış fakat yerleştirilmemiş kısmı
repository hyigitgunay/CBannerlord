// Kamp Fonksiyonu
void kamp(Ozan *ozan, int *uykuSayisi) {
    while (1) {
        printf("\n-------Kamp Alani-------\n");
        printf("1. Kamp Atesinin Basinda Calgi Cal\n");
        printf("2. Nehirde Yikan\n");
        printf("3. Hamama git(10 altin)\n");
        printf("4. Cadirina Girip Uyu\n");
        printf("5. Koy Meydanina Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        can_kontrol(ozan);

        switch (secim) {
            case 1:
                printf("Calgi caliyorsunuz. Moralin artiyor!\n");
                ozan->moral += 25;
                break;
            case 2:
                printf("Nehirde yikandiniz. Hijyen artiyor!\n");
                ozan->hijyen += 20;
                break;
            case 3:
                printf("Hamamda Tellaklar seni yikadi. Hijyenin fullendi!\n");
                ozan->hijyen = 100;
                ozan->altin -= 10;
                break; // 'break' ekledim, aksi halde bir sonraki 'case' çalışabilirdi.
            case 4:
                printf("Uyudunuz. Enerjiniz yenilendi!\n");
                ozan->uyku = 100;
                (*uykuSayisi)++; // Uyku sayısını artır
                hijyen_azalt(ozan, 10);  // Her uyuma işleminde hijyen 10 azalacak
                if (*uykuSayisi % 5 == 0) {
                    ozan->yas++;  // Her 5 uyku sonrası yaş artışı
                }
                break;
            case 5:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

