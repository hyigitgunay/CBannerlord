void dusman_olustur(int seviyeye, Karakter *dusman) {
    srand(time(NULL));

    switch (seviyeye) {
        case 1:
            dusman->guc = rand() % 3 + 1;
            dusman->ceviklik = rand() % 3 + 1;
            dusman->dayaniklilik = rand() % 3 + 1;
            break;
        case 2:  // Orta
            dusman->guc = rand() % 3 + 4;
            dusman->ceviklik = rand() % 3 + 4;
            dusman->dayaniklilik = rand() % 3 + 4;
            break;
        case 3:  // Zor
            dusman->guc = rand() % 4 + 7;
            dusman->ceviklik = rand() % 4 + 7;
            dusman->dayaniklilik = rand() % 4 + 7;
            break;
    }

    dusman->can = dusman->guc * 10;  // Düşmanın başlangıç canı
}
int hasar_hesapla(Karakter saldiran, Karakter savunan) {
    int hasar = 4 * saldiran.guc;
    int savunulan_hasar = hasar - (hasar * 4 * savunan.dayaniklilik) / 100;
    return savunulan_hasar > 0 ? savunulan_hasar : 0;
}

int kacinma_basari(int ceviklik) {
    return (rand() % 100) < (4 * ceviklik);
}


void durum_goster(Karakter ozan, Karakter dusman) {
    printf("\nOzan'in Durumu:\n");
    printf("Can: %d, Güc: %d, Ceviklik: %d, Dayaniklilik: %d\n", ozan.can, ozan.guc, ozan.ceviklik, ozan.dayaniklilik);
    printf("\nDusmanin Durumu:\n");
    printf("Can: %d, Güc: %d, Ceviklik: %d, Dayaniklilik: %d\n", dusman.can, dusman.guc, dusman.ceviklik, dusman.dayaniklilik);
}

void savas(Karakter *ozan, Karakter *dusman) {
    while (ozan->can > 0 && dusman->can > 0) {
        int secim;
        printf("\nSavas: Secenekler\n");
        printf("1. Saldir\n");
        printf("2. Kac\n");
        printf("Seciminizi yapin: ");
        scanf("%d", &secim);

        if (secim == 1) {
            int dusman_hasar = hasar_hesapla(*ozan, *dusman);
            dusman->can -= dusman_hasar;
            printf("Ozan düşmana %d hasar verdi.\n", dusman_hasar);
        } else if (secim == 2) {
            if (kacinma_basari(ozan->ceviklik)) {
                printf("Ozan başarıyla kaçtı!\n");
                return;
            } else {
                printf("Ozan kaçmaya çalıştı ama başarısız oldu.\n");
                ozan->can -= 10;
                printf("Ozan 10 hasar aldı.\n");
            }
        }

        if (dusman->can > 0) {
            int ozan_hasar = hasar_hesapla(*dusman, *ozan);
            ozan->can -= ozan_hasar;
            printf("Dusman Ozan'a %d hasar verdi.\n", ozan_hasar);
        }

        durum_goster(*ozan, *dusman);
    }

    if (ozan->can <= 0) {
        printf("Ozan hayatını kaybetti!\n");
    } else if (dusman->can <= 0) {
        printf("Düşman öldü! Ozan kazandı.\n");
    }
}

// Macera Fonksiyonu
void macera(Ozan *ozan) {
    srand(time(NULL));
    while (1) {
        printf("\n-------Macera-------\n");
        printf("1. Yakin cevreden sifali bitki topla ve avlan\n");
        printf("2. Ormana Kesfe Cik(Kolay)\n");
        printf("3. Kayaliklari Kesfe Cik(orta)\n");
        printf("4. Ana Kenti Keşfe git(Zor)\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        switch (secim) {
            case 1: {
                double sans = ((ozan->toplayicilik * 4) / 100.0);
                printf("Toplayicilik sansi: %.2f%%\n", sans * 100);

                if ((rand() % 100) < (sans * 100)) {
                    printf("Sifalı bitki buldunuz! Caniniz 10 artti.\n");
                    ozan->can += 10;
                } else if ((rand() % 100) < (sans * 50)) {
                    printf("Meyve buldunuz! Toklugunuz 10 artti.\n");
                    ozan->tokluk += 10;
                } else if ((rand() % 100) < (sans * 25)) {
                    printf("Av hayvani avladiniz! Toklugunuz 50 artti.\n");
                    ozan->tokluk += 50;
                } else {
                    printf("Hicbir sey bulamadiniz.\n");
                }

                ozan->hijyen -= 10;
                durumu_goster(ozan);
                break;
            }
            case 2:
                ozan->guc += 20;
                ozan->altin += 30;
                ozan->hijyen -= 20;
                ozan->can -= 30;
                break;
            case 3:
                ozan->guc += 30;
                ozan->altin += 50;
                ozan->hijyen -= 30;
                ozan->can -= 50;
                break;
            case 4:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

