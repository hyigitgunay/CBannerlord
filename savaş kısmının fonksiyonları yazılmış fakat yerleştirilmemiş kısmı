    if (ozan->tokluk < 0) ozan->tokluk = 0;

    ozan->uyku += uyku_degisim;
    if (ozan->uyku > 100) ozan->uyku = 100;
    if (ozan->uyku < 0) ozan->uyku = 0;

    ozan->hijyen += hijyen_degisim;
    if (ozan->hijyen > 100) ozan->hijyen = 100;
    if (ozan->hijyen < 0) ozan->hijyen = 0;

