    printf("Guc: %d\nCeviklik: %d\nDayaniklilik: %d\nKarizma: %d\nToplayicilik: %d\n", ozan.guc, ozan.ceviklik, ozan.dayaniklilik, ozan.karizma, ozan.toplayicilikPuani);
}

// Ana Program
int main() {
    Ozan ozan = {"", "", 18, 100, 1, 100, 0, 100, 100, 10, 3, 3, 3, 3, 100};

    printf("Ozanin Adini Giriniz: ");
    fgets(ozan.ozanAdi, sizeof(ozan.ozanAdi), stdin);
