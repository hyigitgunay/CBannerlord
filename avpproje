    printf("Calginin Adini Giriniz: ");
    fgets(ozan.calgiAdi, sizeof(ozan.calgiAdi), stdin);
    ozan.calgiAdi[strcspn(ozan.calgiAdi, "\n")] = '\0';

    while (1) {
        menu();
        int secim;
        scanf("%d", &secim);

        switch (secim) {
            case 1:
                kamp(&ozan);
                break;
            case 2:
                sifahane(&ozan);
                break;
            case 3:
                Han(&ozan);
                break;
            case 4:
                Macera(&ozan);
                break;
            case 5:
                printf("\nSeviye atlama işlemi gerçekleştirildi.\n");
                ozan.level++;
                ozan.tecrube = 0;
                break;
            case 6:
                durumu_goster(ozan);
                break;
            case 7:
                printf("Oyundan çikmak istediginize emin misiniz? (E/H): ");
                char cikis_onayi;
                scanf(" %c", &cikis_onayi);
                if (cikis_onayi == 'E' || cikis_onayi == 'e') {
                    printf("Oyun sonlandiriliyor...\n");
                    exit(0);
                }
                break;
            default:
                printf("Gecersiz giris! Lutfen tekrar deneyin.\n");
        }
    }

    return 0;
