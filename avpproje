#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
   char ozanAdi[50];
   char calgiAdi[50];
   int yas;
   int para;
   int level;
   int canDegeri;
   int tecrube;
   int tokluk;
   int uykuSeviye;
   int guc;
   int moral;
   int ceviklik;
   int dayaniklilik;
   int karizma;
   int toplayicilikPuani;
   int hijyen;
} Ozan;

// Menu Fonksiyonu
void menu() {
    printf("1. Kamp alanina git\n");
    printf("2. Yildirim Darusifasina git\n");
    printf("3. Hana git\n");
    printf("4. Maceraya atil\n");
    printf("5. Seviye atla\n");
    printf("6. Durumu goster\n");
    printf("7. Oyundan cik\n");
    printf("----------\n");
    printf("Seciminizi yapin: ");
}

// Kamp Fonksiyonu
void kamp(Ozan *ozan) {
    while (1) {
        printf("\n-------Kamp Alani-------\n");
        printf("1. Kamp Atesinin Basinda Calgi Cal\n");
        printf("2. Nehirde Yikan\n");
        printf("3. Cadirina Girip Uyu\n");
        printf("4. Koy Meydanina Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        switch (secim) {
            case 1:
                printf("Calgi caliyorsunuz. Moralin artiyor!\n");
                ozan->moral += 5;
                break;
            case 2:
                printf("Nehirde yikandiniz. Hijyen artiyor!\n");
                ozan->hijyen = 100;
                break;
            case 3:
                printf("Uyudunuz. Enerjiniz yenilendi!\n");
                ozan->uykuSeviye = 100;
                break;
            case 4:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

// Sifahane Fonksiyonu
void sifahane(Ozan *ozan) {
    while (1) {
        printf("\n-------Yildirim Darusifasi-------\n");//islemlerden kac altin alinacagini yaz
        printf("1. Tabipden yaralarini sarmani iste(+25 can puani verir)\n");
        printf("2. Tabipden seni ameliyata almasini iste(Canini fuller)\n");
        printf("3. Koy Meydanina Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        switch (secim) {
            case 1:
                printf("Yaralariniz sarildi. Caniniz yenilendi!\n");
                ozan->canDegeri = 100;
                break;
            case 2:
                printf("Merhem alindi. Hijyen ve can artiyor!\n");
                ozan->hijyen += 10;
                ozan->canDegeri += 10;
                break;
            case 3:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

// Han Fonksiyonu
void han(Ozan *ozan) {
    while (1) {
        printf("\n-------Han-------\n");
        printf("1. Yiyecek Satin Al ve Ye\n");
        printf("2. Icecek Satin Al ic ve Eglen\n");
        printf("3. Enstruman cal ve sarki Soyle\n");
        printf("4. Koy Meydanina Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        switch (secim) {
            case 1:
                printf("Yemek yediniz. Tokluk artiyor!\n");
                ozan->tokluk = 100;
                break;
            case 2:
                printf("Icecek ictiniz. Moraliniz duzeliyor!\n");
                ozan->karizma += 5;
                break;
            case 3:
                printf("Sarki soylediniz. Para kazandiniz!\n");
                ozan->para += 20;
                break;
            case 4:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

// Macera Fonksiyonu
void macera(Ozan *ozan) {
    while (1) {
        printf("\n-------Macera-------\n");
        printf("1. Yakin cevreden sifali bitki topla ve avlan\n");
        printf("2. Ormana Kesfe Cik(Kolay)\n");
        printf("3. Kayaliklari Kesfe Cik(orta)\n");
        printf("4. Vadiye Kesfe Cik(zor)\n");
        printf("5. Koy Meydanina Geri Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        switch (secim) {
            case 1:
                printf("Bitki topladiniz ve avlandiniz. Tecrube kazandiniz!\n");
                ozan->tecrube += 10;
                break;
            case 2:
                printf("Kolay kesif basarili. Tecrube kazandiniz!\n");
                ozan->tecrube += 15;
                break;
            case 3:
                printf("Orta zorlukta kesif tamamlandi. Daha cok tecrube kazandiniz!\n");
                ozan->tecrube += 25;
                break;
            case 4:
                printf("Zor kesif tamamlandi. Buyuk tecrube kazandiniz!\n");
                ozan->tecrube += 40;
                break;
            case 5:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

// Durumu Goster Fonksiyonu
void durumu_goster(Ozan ozan) {
    printf("\n--- Karakter Durumu ---\n");
    printf("Isim: %s\nCalgi: %s\n", ozan.ozanAdi, ozan.calgiAdi);
    printf("Can: %d\nMoral: %d\nTokluk: %d\nUyku: %d\nHijyen: %d\n", ozan.canDegeri,ozan.moral, ozan.tokluk, ozan.uykuSeviye, ozan.hijyen);
    printf("Seviye: %d\nTecrube Puani: %d\nAltin: %d\n", ozan.level, ozan.tecrube, ozan.para);
    printf("Guc: %d\nCeviklik: %d\nDayaniklilik: %d\nKarizma: %d\nToplayicilik: %d\n", ozan.guc, ozan.ceviklik, ozan.dayaniklilik, ozan.karizma, ozan.toplayicilikPuani);
    printf("----------\n");
}

// Ana Program
int main() {
    Ozan ozan = {
    "",             // ozanAdi: Kullanıcıdan alınacak
    "",             // calgiAdi: Kullanıcıdan alınacak
    18,             // yas: Başlangıçta standart yaş
    50,             // para: Başlangıçta 50 altın
    1,              // level: Başlangıç seviyesi
    100,            // canDegeri: Tam sağlık
    0,              // tecrube: Yeni başlıyor, 0 deneyim
    100,            // tokluk: Tok
    100,            // uykuSeviye: Dinlenmiş durumda
    10,             // guc: Başlangıç gücü
    50,             // moral: Orta düzeyde moral
    10,             // ceviklik: Başlangıç çevikliği
    10,             // dayaniklilik: Başlangıç dayanıklılığı
    5,              // karizma: Ortalama karizma
    10,             // toplayicilikPuani: Toplayıcılık başlangıç seviyesi
    80              // hijyen: Biraz yıpranmış hijyen
};

    printf("Ozanin Adini Giriniz: ");
    fgets(ozan.ozanAdi, sizeof(ozan.ozanAdi), stdin);
    ozan.ozanAdi[strcspn(ozan.ozanAdi, "\n")] = '\0';

    printf("Calginin Adini Giriniz: ");
    fgets(ozan.calgiAdi, sizeof(ozan.calgiAdi), stdin);
    ozan.calgiAdi[strcspn(ozan.calgiAdi, "\n")] = '\0';

    while (1) {
        menu();
        int secim;
        scanf("%d", &secim);

        switch (secim) {
            case 1:
                kamp(&ozan);
                break;
            case 2:
                sifahane(&ozan);
                break;
            case 3:
                han(&ozan);
                break;
            case 4:
                macera(&ozan);
                break;
            case 5:
                printf("\nSeviye atlama islemi gerceklestirildi.\n");
                ozan.level++;
                ozan.tecrube = 0;
                break;
            case 6:
                durumu_goster(ozan);
                break;
            case 7:
                printf("Oyundan cikmak istediginize emin misiniz? (E/H): ");
                char cikis_onayi;
                scanf(" %c", &cikis_onayi);
                if (cikis_onayi == 'E' || cikis_onayi == 'e') {
                    printf("Oyun sonlandiriliyor...\n");
                    exit(0);
                }
                break;
            default:
                printf("Gecersiz giris! Lutfen tekrar deneyin.\n");
        }
    }
    return 0;
}
