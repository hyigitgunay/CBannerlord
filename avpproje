// Kamp Fonksiyonu
void kamp(Ozan *ozan, int *uykuSayisi) {
    while (1) {
        printf("\n-------Kamp Alani-------\n");
        printf("1. Kamp Atesinin Basinda Calgi Cal\n");
        printf("2. Nehirde Yikan\n");
        printf("3. Hamama git==10 altin\n");
        printf("4. Cadirina Girip Uyu\n");
        printf("5. Koy Meydanina Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        can_kontrol(ozan);

        switch (secim) {
            case 1:
                printf("Calgi caliyorsunuz. Moralin artiyor!\n");
                ozan->moral += 25;
                break;
            case 2:
                printf("Nehirde yikandiniz. Hijyen artiyor!\n");
                ozan->hijyen += 20;
                break;
            case 3:
                printf("Hamamda Tellaklar seni yikadi. Hijyenin fullendi!\n");
                ozan->hijyen = 100;
                ozan->altin -= 10;
            case 4:
                printf("Uyudunuz. Enerjiniz yenilendi!\n");
                ozan->uyku = 100;
                (*uykuSayisi)++; // Uyku sayısını artır
                hijyen_azalt(ozan, 10);  // Her uyuma işleminde hijyen 10 azalacak
                if (*uykuSayisi % 5 == 0) {
                    ozan->yas++;  // Her 5 uyku sonrası yaş artışı
                }
                break;
            case 5:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}


// Sifahane Fonksiyonu
void sifahane(Ozan *ozan) {
    while (1) {
        printf("\n-------Yildirim Darussifasi-------\n");
        printf("1. Tabipden yaralarini sarmani iste(+25 can puani verir)==-25 altin\n");
        printf("2. Tabipden seni ameliyata almasini iste(Canini fuller)==-50 altin\n");
        printf("3. Koy Meydanina Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        switch (secim) {
            case 1:
            if (ozan->altin >= 25) {
                printf("Yaralariniz sarildi. Hijyen ve can artiyor!\n");
                ozan->hijyen += 10;
                ozan->can += 25;
                ozan->altin -= 25;
                }
            else {
                printf("Yeterli altin yok!\n");
                }
                break;
            case 2:
            if (ozan->altin >= 50) {
                printf("Tabip ameliyata aldı. Caniniz yenilendi!\n");
                ozan->can = 100;
                ozan->altin -= 50;
                }
            else {
                printf("Yeterli altin yok!\n");
                }
                break;
            case 3:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

// Han Fonksiyonu
void han(Ozan *ozan) {

    while (1) {
        printf("\n-------Han-------\n");
        printf("1. As Ocagina Git.\n");
        printf("2. Kimiz Satin Al ic ve Eglen==5 Altin\n");
        printf("3. Enstruman cal ve sarki Soyle\n");
        printf("4. Koy Meydanina Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        int secim2;
        scanf("%d", &secim);
        switch (secim) {
            case 1:
                printf("-------As Ocagi-------\n");
                printf("1. Elma Satin Al ve Ye==5 Altin\n");
                printf("2. Ekmek Satin Al ve Ye==10 Altin\n");
                printf("3. Kebap Satin Al ve Ye==25 Altin\n");
                printf("Seciminizi yapin: ");
                scanf("%d",&secim2);
                if(secim2==1){
                    ozan->tokluk += 5;
                    ozan->altin -= 5;
                    ozan->hijyen -= 5;
                    printf("Elma Yediniz Tokluk Artiyor .Afiyet Olsun!\n");
                    printf("----------\n");
                }
                else if(secim2==2){
                    ozan->tokluk += 10;
                    ozan->altin -= 10;
                    ozan->hijyen -= 10;
                    printf("Ekmek Yediniz Tokluk Artiyor .Afiyet Olsun!\n");
                    printf("----------\n");
                }
                else if(secim2==3){
                    ozan->tokluk += 50;
                    ozan->altin -= 25;
                    ozan->hijyen -= 15;
                    printf("Kebap Yediniz Tokluk Artiyor .Afiyet Olsun!\n");
                    printf("----------\n");
                }
                else{
                    printf("Gecersiz secim!\n");
                }

                break;
            case 2:
                printf("Kimiz ictiniz. Moraliniz duzeliyor ve Karizmaniz Artiyor!\n");
                ozan->karizma += 5;
                ozan->moral += 5;
                break;
            case 3:
                printf("Sarki soylediniz. Para kazandiniz!\n");
                ozan->altin += 10 + (ozan->karizma * ozan->hijyen / 100);
                ozan->hijyen -= 10;
                break;
            case 4:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

// Macera Fonksiyonu
void macera(Ozan *ozan) {
    while (1) {
        printf("\n-------Macera-------\n");
        printf("1. Yakin cevreden sifali bitki topla ve avlan\n");
        printf("2. Ormana Kesfe Cik(Kolay)\n");
        printf("3. Kayaliklari Kesfe Cik(orta)\n");
        printf("4. Vadiye Kesfe Cik(zor)\n");
        printf("5. Koy Meydanina Geri Don\n");
        printf("----------\n");
        printf("Seciminizi yapin: ");
        int secim;
        scanf("%d", &secim);
        switch (secim) {
            case 1:
                printf("Bitki topladiniz ve avlandiniz. Tecrube kazandiniz!\n");
                ozan->tecrube += 10;
                hijyen_azalt(ozan, 20);  // Keşif sırasında hijyen 20 azalacak
                break;
            case 2:
                printf("Kolay kesif basarili. Tecrube kazandiniz!\n");
                ozan->tecrube += 15;
                hijyen_azalt(ozan, 20);  // Keşif sırasında hijyen 20 azalacak
                break;
            case 3:
                printf("Orta zorlukta kesif tamamlandi. Daha cok tecrube kazandiniz!\n");
                ozan->tecrube += 25;
                hijyen_azalt(ozan, 20);  // Keşif sırasında hijyen 20 azalacak
                break;
            case 4:
                printf("Zor kesif tamamlandi. Buyuk tecrube kazandiniz!\n");
                ozan->tecrube += 40;
                hijyen_azalt(ozan, 20);  // Keşif sırasında hijyen 20 azalacak
                break;
            case 5:
                return;
            default:
                printf("Gecersiz secim!\n");
        }
    }
}

// Seviye Atlama Fonksiynu
void seviye_atla(Ozan ozan) {
    printf("\n---  Seviye ---\n");
    ozan.tecrube = 0;
    ozan.seviye++;
    printf("----------\n");
}

// Durumu Goster Fonksiyonu
void durumu_goster(Ozan ozan) {
    printf("\n--- Karakter Durumu ---\n");
    printf("Isim: %s\nCalgi: %s\n", ozan.ozanAdi, ozan.calgiAdi);
    printf("Can: %d\nYas: %d\nMoral: %d\nTokluk: %d\nUyku: %d\nHijyen: %d\n", ozan.can,ozan.yas,ozan.moral, ozan.tokluk, ozan.uyku, ozan.hijyen);
    printf("Seviye: %d\nTecrube Puani: %d\nAltin: %d\n", ozan.seviye, ozan.tecrube, ozan.altin);
    printf("Guc: %d\nCeviklik: %d\nDayaniklilik: %d\nKarizma: %d\nToplayicilik: %d\n", ozan.guc, ozan.ceviklik, ozan.dayaniklilik, ozan.karizma, ozan.toplayicilik);
    printf("----------\n");
}

// Ozan baslangic durumu
void ozan_baslangic(Ozan *ozan) {
    ozan->can = 100;
    ozan->tokluk = 100;
    ozan->uyku = 100;
    ozan->hijyen = 100;
    ozan->altin = 100;
    ozan->tecrube = 0;
    ozan->seviye = 1;
    ozan->guc = 3;
    ozan->ceviklik = 3;
    ozan->dayaniklilik = 3;
    ozan->karizma = 3;
    ozan->toplayicilik = 3;
    ozan->yas = 18;
    ozan->moral = 100;
}

// Nitelik güncelleme
void nitelik_guncelle(Ozan *ozan, int tokluk_degisim, int uyku_degisim, int hijyen_degisim,int uykuAzalt,int yemekYe) {
    ozan->tokluk += tokluk_degisim;
    if (ozan->tokluk > 100) ozan->tokluk = 100;
    if (ozan->tokluk < 0) ozan->tokluk = 0;

    ozan->uyku += uyku_degisim;
    if (ozan->uyku > 100) ozan->uyku = 100;
    if (ozan->uyku < 0) ozan->uyku = 0;

    ozan->hijyen += hijyen_degisim;
    if (ozan->hijyen > 100) ozan->hijyen = 100;
    if (ozan->hijyen < 0) ozan->hijyen = 0;

    if (ozan->tokluk < 20) printf("Uyari: Tokluk seviyesi kritik!\n");
    if (ozan->uyku < 20) printf("Uyari: Uyku seviyesi kritik!\n");
    if (ozan->hijyen < 20) printf("Uyari: Hijyen seviyesi kritik!\n");


    if (ozan->uyku < 0) ozan->uyku = 0; // Uyku seviyesi 0'dan küçük olmasın


    ozan->hijyen -= 10; // Hijyen seviyesini her uyku sonrası 10 azalt

    // Hijyen ve uyku kritik seviyeye geldiğinde uyarı ver
    if (ozan->hijyen < 20) {
        printf("Uyarı: Hijyen seviyesi kritik!\n");
    }
    if (ozan->uyku < 20) {
        printf("Uyarı: Uyku seviyesi kritik!\n");
    }

    // Can seviyesini etkileyen mantık
    if (ozan->uyku <= 0) {
        ozan->can -= 10; // Uyku sıfırlandığında can azalır

    ozan->hijyen -= 20; // Hijyen seviyesini 20 azalt

    // Hijyen kritik seviyeye geldiğinde uyarı ver
    if (ozan->hijyen < 20) {
        printf("Uyarı: Hijyen seviyesi çok düşük!\n");
    }

    // Yemek sonrası durum
    printf("Ozan yemek yedi. Yeni Hijyen Seviyesi: %d\n", ozan->hijyen);
}


    }



