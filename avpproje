        if (ozan->guc > 25) ozan->guc = 25;
    } else if (strcmp(beceri_adi, "ceviklik") == 0) {
        ozan->ceviklik += puan;
        if (ozan->ceviklik > 25) ozan->ceviklik = 25;
    } else if (strcmp(beceri_adi, "dayaniklilik") == 0) {
        ozan->dayaniklilik += puan;
        if (ozan->dayaniklilik > 25) ozan->dayaniklilik = 25;
    } else if (strcmp(beceri_adi, "karizma") == 0) {
        ozan->karizma += puan;
        if (ozan->karizma > 25) ozan->karizma = 25;
    } else if (strcmp(beceri_adi, "toplayicilik") == 0) {
        ozan->toplayicilik += puan;
        if (ozan->toplayicilik > 25) ozan->toplayicilik = 25;
    } else {
        printf("Geçersiz beceri adý!\n");
    }
}

