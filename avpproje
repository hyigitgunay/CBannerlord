#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
   char ozanAdi[50];
   char calgiAdi[50];
   int yas;
   int altin;
   int seviye;
   int can;
   int tecrube;
   int tokluk;
   int uyku;
   int guc;
   int moral;
   int ceviklik;
   int dayaniklilik;
   int karizma;
   int toplayicilik;
   int hijyen;
} Ozan;

// Can kontrolü
void can_kontrol(Ozan *ozan) {
    if (ozan->tokluk == 0) ozan->can -= 20;
    if (ozan->uyku == 0) ozan->can -= 10;
    if (ozan->hijyen == 0) ozan->can -= 5;
    if (ozan->moral > 100) ozan->moral= 100;


    if (ozan->can > 100) ozan->can = 100;
    if (ozan->can <= 0) {
        ozan->can = 0;
        printf("Ozan öldü! Oyun sona erdi.\n");
        exit(0);
    }
}

// Hijyen azalma fonksiyonu
void hijyen_azalt(Ozan *ozan, int azalma_miktari) {
    ozan->hijyen -= azalma_miktari;  // Hijyen miktarını azalt
    if (ozan->hijyen < 0) ozan->hijyen = 0;  // Hijyen 0'dan düşük olmasın
    printf("Hijyen azaldi. Mevcut hijyen: %d\n", ozan->hijyen);
}


