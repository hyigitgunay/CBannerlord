// Durumu Göster Fonksiyonu
void durumu_goster(Ozan ozan) {
    printf("\n--- Karakter Durumu ---\n");
    printf("Isim: %s\nCalgi: %s\n", ozan.ozanAdi, ozan.calgiAdi);
    printf("Can: %d\nTokluk: %d\nUyku: %d\nHijyen: %d\n", ozan.canDegeri, ozan.tokluk, ozan.uykuSeviye, ozan.hijyen);
